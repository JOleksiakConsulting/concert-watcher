# Required; the API refuses to start without it. Think of one or generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

DATABASE_URL=sqlite+aiosqlite:///./data/concert-watcher.db

TICKETMASTER_API_KEY=

DEFAULT_COUNTRIES=PL

# Local daily digest runner
DIGEST_API_URL=http://127.0.0.1:8182
DIGEST_COUNTRY_CODES=PL
DIGEST_SOURCES=ticketmaster,knockout,fource
DIGEST_LIMIT=200
DIGEST_HTTP_TIMEOUT_SECONDS=600

# SMTP used by the daily digest runner (`app.cli.daily_digest`)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

HTTP_TIMEOUT_SECONDS=20
TICKETMASTER_HTTP_TIMEOUT_SECONDS=120
CRAWLER_MIN_DELAY_SECONDS=2
CRAWLER_USER_AGENT=ConcertWatcher/1.0

SOURCE_TICKETMASTER_ENABLED=true
SOURCE_KNOCKOUT_ENABLED=true
SOURCE_FOURCE_ENABLED=true
# Future adapters (not implemented yet)
SOURCE_EBILET_ENABLED=false
SOURCE_EVENTIM_ENABLED=false
SOURCE_GOING_ENABLED=false
SOURCE_LIVENATION_ENABLED=false
